      "name": "Scenario 2: Get All Employees",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Test to see the full dashboard with all employees//",
              "//Sanity Check: verify we recieved a code 200//",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "//Here we get all the employees in the list//",
              "const employeeListData = pm.response.json();",
              "//Here we use the employeeId we created in POST//",
              "const savedId = pm.collectionVariables.get(\"employeeId\"); ",
              "",
              "//Validation to check if the employee created is in the list//",
              "pm.test(\"Verify created employee is in the dashboard\", function () {",
              "    let employeeFound = null;",
              "    for (let i = 0; i < employeeListData.length; i++){",
              "        if(employeeListData[i].id === savedId){",
              "            employeeFound = employeeListData[i];",
              "            break;",
              "        }",
              "    }",
              "//Verify employee value is not null and the username match the user who created the employee//",
              "    pm.expect(employeeFound).to.not.be.null;",
              "    pm.expect(employeeFound.username).to.eql(\"TestUser961\");",
              "});"
            ],
