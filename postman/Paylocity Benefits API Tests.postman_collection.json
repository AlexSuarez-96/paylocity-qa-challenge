          "listen": "test",
          "script": {
            "exec": [
              "//Test to lookup for a specific employee using the employeeId//",
              "//Sanity Check: verify we recieved a code 200//",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "//Here we get all the data of the specific employee//",
              "const employeeData = pm.response.json();",
              "pm.test(\"Verify correct employee record\", function () {",
              "    //We use TestUser961 id as a beacon//",
              "    pm.expect(employeeData.username).to.eql(\"TestUser961\"); ",
              "    //We verified that employee created on Scenario 1 exists//",
              "    pm.expect(employeeData.firstName).to.eql(\"Wally\");",
