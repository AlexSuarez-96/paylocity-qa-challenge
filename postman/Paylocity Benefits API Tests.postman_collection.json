  "item": [
    {
      "name": "Scenario 1: Add Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Sanity Check: verify we recieved a code 200//",
              "pm.test(\"Status code is 200\", function (){",
              "    pm.response.to.have.status(200); ",
              "    }); ",
              "",
              "const employeeData = pm.response.json(); ",
              "",
              "//Creation of a variable employeeId in the collection that we are gonna use later in other requests//",
              "pm.collectionVariables.set(\"employeeId\", employeeData.id); ",
              "",
              "pm.test(\"Verify Per-Paycheck Calculations\", function () {",
              "    const paychecks = 26;",
              "    const perCheckGross = 2000.00;",
              "",
              "    //Calculation based on dependants qty//",
              "    const dependantsCalculationCost = (employeeData.dependants * 500) / paychecks; ",
              "    ",
              "    //Calculation Cost of the benefits//",
              "    const benefitsCosts = (1000 / paychecks) + dependantsCalculationCost; ",
              "",
              "    //Calculation Salary after deductions//",
              "    const expectedNetPay = perCheckGross - benefitsCosts; ",
              "",
              "//Comparison of data to match the expected values//",
              "    pm.expect(employeeData.gross.toFixed(2)).to.eql(perCheckGross.toFixed(2));",
              "    pm.expect(employeeData.benefitsCost.toFixed(2)).to.eql(benefitsCosts.toFixed(2));",
              "    pm.expect(employeeData.net.toFixed(2)).to.eql(expectedNetPay.toFixed(2));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic VGVzdFVzZXI5NjE6TzBeR105Q2Q4Tnxr"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
