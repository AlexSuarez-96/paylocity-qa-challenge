    {
      "name": "Scenario 4: Edit Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Test to check the system when we made an edit of an employee//",
              "//Sanity Check: verify we recieved a code 200//",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "//Sanity check: verify the response of the JSON and saved it in a variable//",
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Verify Recalculation\", function () {",
              "",
              "    const paychecks = 26;",
              "    const salary = 2000.00;",
              "    const dependantsCalculationCost = (jsonData.dependants * 500) / paychecks;",
              "    const expectedBenefits = (1000 / paychecks) + dependantsCalculationCost;",
              "    ",
              "    const expectedNetPay = salary - expectedBenefits;",
              "",
              "//Verify the response is updated//",
              "    pm.expect(jsonData.firstName).to.eql(\"Jay\");",
              "    pm.expect(jsonData.benefitsCost.toFixed(2)).to.eql(expectedBenefits.toFixed(2));",
              "    pm.expect(jsonData.net.toFixed(2)).to.eql(expectedNetPay.toFixed(2));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
